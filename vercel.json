{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/j/:token",
      "destination": "/api/jam?token=:token"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "node_modules/@vercel/og/dist/**",
      "memory": 1769,
      "maxDuration": 60
    }
  }
}
